{
  "name": "dsh-prompt-library",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "左侧栏提示词库：分组（自动归类）+ 增删改查与搜索，并把提示词插入当前对话草稿。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuezm/dsh-plugins.git",
    "directory": "packages/prompt-library"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
